# TEMPLATE: customize for client
# =============================================================================
# Configuration du backend distant (state Terraform) — environnement DEV.
# =============================================================================
# Copier ce fichier en `backend-dev.hcl` (non versionné, voir .gitignore) et
# remplacer les valeurs par celles du storage account de state provisionné
# via `make bootstrap-tfstate` (voir infrastructure/terraform/README.md).
#
# Usage : make tf-init ENV=dev
# Équivalent direct : terraform init -backend-config=../../environments/backend-dev.hcl

resource_group_name  = "rg-tfstate-<project>"
storage_account_name = "sttfstate<project><suffix>"
container_name       = "tfstate"
key                  = "<project>-dev.tfstate"

# Azure AD (RBAC) plutôt qu'une clé de storage account — cohérent avec le
# reste du starter kit (zéro secret statique). Nécessite le rôle
# "Storage Blob Data Contributor" sur ce storage account, pour l'identité
# qui exécute `terraform init/apply` (utilisateur en local, identité
# fédérée OIDC en CI/CD — voir docs/SECURITY.md).
use_azuread_auth = true
