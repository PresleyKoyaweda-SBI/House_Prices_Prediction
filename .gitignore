# Terraform
# .terraform.lock.hcl N'EST PAS ignoré : il doit être versionné pour garantir
# des versions de providers reproductibles entre postes et CI (recommandation
# officielle HashiCorp).
.terraform/
*.tfstate
*.tfstate.*
backup-before-destroy.json

# Config réelle du backend distant (contient des noms de ressources
# spécifiques au client) — seuls les *.hcl.example sont versionnés.
environments/backend-*.hcl
!environments/backend-*.hcl.example
