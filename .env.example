# Variables de commodité pour le développement local (CLI Azure / Azure ML).
# AUCUN secret ici : l'authentification locale se fait via `az login`
# (compte utilisateur) et l'authentification CI/CD via OIDC fédéré
# (voir docs/SECURITY.md) — jamais via un identifiant client stocké en clair.

AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_REGION=canadacentral

ML_WORKSPACE_NAME=mlw-your-project
RESOURCE_GROUP_NAME=rg-your-project
